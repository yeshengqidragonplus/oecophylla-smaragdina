{
  "name": "oecophylla-smaragdina",
  "displayName": "Oecophylla smaragdina",
  "description": "一个用于小型内网简单通信的 VS Code 插件",
  "version": "0.0.1",
  "repository": "https://github.com/example/example",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:OSChatView",
    "onCommand:myChat.openSettings",
    "onCommand:myChat.newChat",
    "onCommand:myChat.startNetwork",
    "onCommand:myChat.stopNetwork",
    "onCommand:myChat.editPeers",
    "onCommand:myChat.openPeersFile",
    "onCommand:myChat.showLogs",
    "onCommand:myChat.diagnose",
    "onCommand:myChat.scanSubnet"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "OSChatContainer",
          "title": "OS Chat",
          "icon": "media/robot.svg"
        }
      ]
    },
    "views": {
      "OSChatContainer": [
        {
          "type": "webview",
          "id": "OSChatView",
          "name": "OS Chat",
          "icon": "media/robot.svg",
          "contextualTitle": "OS Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "myChat.openSettings",
        "title": "设置",
        "category": "OS Chat",
        "icon": "$(gear)"
      },
      {
        "command": "myChat.newChat",
        "title": "新建会话",
        "category": "OS Chat",
        "icon": "$(add)"
      },
      {
        "command": "myChat.startNetwork",
        "title": "启动网络服务",
        "category": "OS Chat",
        "icon": "$(play)"
      },
      {
        "command": "myChat.stopNetwork",
        "title": "停止网络服务",
        "category": "OS Chat",
        "icon": "$(debug-stop)"
      },
      {
        "command": "myChat.editPeers",
        "title": "编辑聊天对象",
        "category": "OS Chat",
        "icon": "$(account)"
      },
      {
        "command": "myChat.openPeersFile",
        "title": "打开 peers.json 配置文件",
        "category": "OS Chat",
        "icon": "$(file-code)"
      },
      {
        "command": "myChat.showLogs",
        "title": "显示日志",
        "category": "OS Chat",
        "icon": "$(output)"
      },
      {
        "command": "myChat.diagnose",
        "title": "运行诊断（找不到对方时使用）",
        "category": "OS Chat",
        "icon": "$(pulse)"
      },
      {
        "command": "myChat.scanSubnet",
        "title": "扫描网段（广播被过滤时使用）",
        "category": "OS Chat",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "myChat.newChat",
          "when": "view == OSChatView",
          "group": "navigation"
        },
        {
          "command": "myChat.startNetwork",
          "when": "view == OSChatView",
          "group": "navigation"
        },
        {
          "command": "myChat.openSettings",
          "when": "view == OSChatView",
          "group": "navigation"
        },
        {
          "command": "myChat.editPeers",
          "when": "view == OSChatView",
          "group": "navigation"
        },
        {
          "command": "myChat.openPeersFile",
          "when": "view == OSChatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "OS Chat",
      "properties": {
        "oschat.port": {
          "type": "integer",
          "default": 8080,
          "minimum": 1024,
          "maximum": 64535,
          "scope": "machine",
          "markdownDescription": "网络服务使用的 **UDP 主端口**（发现应答与心跳）。聊天与文件走业务端口（= 主端口 + 1000），另有固定的发现端口 41320。这三个 UDP 端口都需要在防火墙中放行。修改后需重启网络服务才能生效。"
        },
        "oschat.nickname": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "你的昵称（可选），显示给局域网内的其他人；留空则使用计算机名。修改后需重启网络服务才能生效。"
        },
        "oschat.autoConnect": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "VS Code 启动后自动启动网络服务（无需先打开侧边栏）。"
        },
        "oschat.peersFilePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "聊天对象配置文件 `peers.json` 所在的**文件夹**路径；留空则保存在扩展全局存储目录。文件格式示例：`[{\"ip\": \"192.168.1.100\", \"port\": 8080, \"nickname\": \"用户A\", \"hostname\": \"PC-A\"}]`"
        },
        "oschat.downloadPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "接收文件保存的**文件夹**路径；留空则保存在扩展全局存储目录下的 `downloads`。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.92.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
